{
  "name": "ai-copilot-agent-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/launch.cjs",
    "configure": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\configure.ps1",
    "install-all": "cd backend && npm install && cd ../frontend && npm install",
    "start-backend": "npm --prefix backend start",
    "start-frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run start-backend\" \"npm run start-frontend\"",
    "dev:classic": "npm run dev",
    "build": "npm --prefix frontend run build",
    "release:prepare": "node scripts/release.cjs",
    "deploy:prepare": "node scripts/launch.cjs --prepare"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "framer-motion": "^12.34.0",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "react-i18next": "^16.5.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
