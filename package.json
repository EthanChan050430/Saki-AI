{
  "name": "ai-copilot-agent-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "configure": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\configure.ps1",
    "install-all": "cd backend && npm install && cd ../frontend && npm install",
    "start-backend": "cd backend && set QQBOT_AUTO_CONNECT=1&& npm start",
    "start-frontend-delayed": "powershell -NoProfile -Command \"Start-Sleep -Seconds 4; Set-Location 'frontend'; npm run dev\"",
    "start-frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run start-backend\" \"npm run start-frontend-delayed\"",
    "dev:classic": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "framer-motion": "^12.34.0",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "react-i18next": "^16.5.4"
  }
}
