# Native production defaults. Copy to .env; existing environment variables take priority.
NODE_ENV=production
SAKI_PROFILE=light
PORT=5480
AGENT_HOST=127.0.0.1
SAKI_HEAP_MB=384
# Keyword memory avoids downloading/loading a local embedding model.
SAKI_EMBEDDINGS=keyword
SAKI_CRAWLER=static
QQBOT_AUTO_CONNECT=0
# SAKI_DATA_DIR=/absolute/path/to/data
# CHECKPOINT_STORE_DIR=/absolute/path/to/checkpoints
# SAKI_BACKGROUND_TASKS=0
# For local embeddings: install optional dependencies and set SAKI_EMBEDDINGS=lazy.
# For JS web crawling: install Chrome separately and set SAKI_CRAWLER=browser.
